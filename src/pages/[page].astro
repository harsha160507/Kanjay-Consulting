---
import { routeContext } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/site';
import ServicesIndex from '../components/ServicesIndex.astro';
interface Props { title: string }
export function getStaticPaths() {
  return pages.map(page => ({ params: { page: page.slug }, props: { title: page.title } }));
}
const { title } = Astro.props;
const route = routeContext(Astro.url.pathname);
---
<BaseLayout title={title}>
  <h1>{title}</h1>
  {title === 'Services' ? <ServicesIndex /> : <div class="draft-note"><strong>Internal draft · Page content pending.</strong> This route previews the shared layout. {['Terms of Use', 'Privacy Policy', 'Cookie Policy', 'Disclaimer'].includes(title) ? 'Policy content and review are deferred.' : 'Final page content is outside this phase. Unsupported business claims are omitted.'}</div>}
  <a href={route.to('/')}>Return to Home</a>
</BaseLayout>
