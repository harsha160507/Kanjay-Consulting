---
import { routeContext } from '../lib/routes';
import BaseLayout from '../layouts/BaseLayout.astro';
import { pages } from '../data/site';
import ServicesPage from '../components/ServicesPage.astro';
import AboutPage from '../components/AboutPage.astro';
interface Props { title: string }
export function getStaticPaths() {
  return pages.map(page => ({ params: { page: page.slug }, props: { title: page.title } }));
}
const { title } = Astro.props;
const route = routeContext(Astro.url.pathname);
---
{title === 'About Us' ? <BaseLayout title="About Kanjay Consulting" phaseLabel="Phase 5 · About draft" description="Learn about Kanjay Consulting, established in 2014: HR support globally. GeM consulting since 2018. Current GeM seller support across India."><AboutPage /></BaseLayout> : title === 'Services' ? <BaseLayout title="HR & GeM seller services" phaseLabel="Phase 6 · Services draft" description="Explore Kanjay Consulting’s HR support and GeM seller services, with business and candidate contact routes."><ServicesPage /></BaseLayout> : <BaseLayout title={title}>
  <h1>{title}</h1>
  <div class="draft-note"><strong>Internal draft · Page content pending.</strong> This route previews the shared layout. {['Terms of Use', 'Privacy Policy', 'Cookie Policy', 'Disclaimer'].includes(title) ? 'Policy content and review are deferred.' : 'Final page content is outside this phase. Unsupported business claims are omitted.'}</div>
  <a href={route.to('/')}>Return to Home</a>
</BaseLayout>}
