---
import '../styles/global.css';
import { business } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
interface Props { title: string }
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>try { const t = localStorage.getItem('kanjay-theme'); if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t; } catch {}</script>
    <title>{title} | {business.projectName} development</title>
    <meta name="description" content="Unpublished development foundation for the Kanjay Consulting redesign." />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="review-banner">INTERNAL DESIGN REVIEW <span>Phase 2 · Shared layout</span></div>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
