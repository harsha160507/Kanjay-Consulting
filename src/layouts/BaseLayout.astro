---
import '../styles/global.css';
import { business } from '../data/site';
import Header from '../components/layout/Header.astro';
import Footer from '../components/layout/Footer.astro';
import { routeContext } from '../lib/routes';
interface Props { title: string; phaseLabel?: string; description?: string }
const { title, phaseLabel = 'Phase 2 · Shared layout', description = 'Unpublished development foundation for the Kanjay Consulting redesign.' } = Astro.props;
const { theme } = routeContext(Astro.url.pathname);
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <script is:inline>try { const t = localStorage.getItem('kanjay-theme'); if (!document.documentElement.dataset.theme && (t === 'light' || t === 'dark') && location.pathname !== '/404.html') location.replace('/theme/' + t + location.pathname + location.search + location.hash); } catch {}</script>
    <title>{title} | {business.projectName} development</title>
    <meta name="description" content={description} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="review-banner">INTERNAL DESIGN REVIEW <span>{phaseLabel}</span></div>
    <Header />
    <main id="main" tabindex="-1"><slot /></main>
    <Footer />
  </body>
</html>
