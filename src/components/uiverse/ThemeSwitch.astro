<!-- Adapted from supplied Uiverse toggle by JkHuger. -->
<label class="theme"><span class="sr-only">Switch colour theme</span><input id="theme-toggle" class="theme__toggle" type="checkbox" /><span class="theme__icon" aria-hidden="true">◐</span></label>
<script>
  const toggle = document.querySelector<HTMLInputElement>('#theme-toggle');
  const system = matchMedia('(prefers-color-scheme: dark)');
  let explicit = document.documentElement.dataset.theme;
  const apply = (dark: boolean) => { document.documentElement.dataset.theme = dark ? 'dark' : 'light'; if (toggle) toggle.checked = dark; };
  apply(explicit ? explicit === 'dark' : system.matches);
  toggle?.addEventListener('change', () => { explicit = toggle.checked ? 'dark' : 'light'; apply(toggle.checked); try { localStorage.setItem('kanjay-theme', explicit); } catch {} });
  system.addEventListener('change', () => { if (!explicit) apply(system.matches); });
</script>
